# RobbIA — variáveis de ambiente (exemplo). Copie para .env e preencha.
# Segredos NUNCA são versionados (ver .gitignore). CES gerencia credenciais de runtime.

# --- Banco de dados (núcleo Linux) ---
DATABASE_URL=postgres://robbia:robbia@localhost:5432/robbia

# --- App web (Harness UI) ---
WEB_PORT=3000

# --- Gateway (Fastify + WebSocket) — stories 2.x/4.x ---
GATEWAY_PORT=3001

# --- CES (Credential Execution Service) — story 3.1 ---
# Chave mestra de envelope encryption (AES-GCM); fora do banco, injetada pelo host.
CES_MASTER_KEY=

# --- Providers de LLM (chaves) — story 1.3+ ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- IA Arquiteta (geração de Harness no Builder) — story 1.7 ---
# Provider/Modelo usados pelo server action proposeHarness (resolvidos no servidor).
# ARCHITECT_PROVIDER: claude | gpt | gemini | ollama | openrouter (usa a chave correspondente acima).
ARCHITECT_PROVIDER=
ARCHITECT_MODEL=
